{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@screens/*":    ["src/screens/*"],
      "@components/*": ["src/components/*"],
      "@utils/*":      ["src/utils/*"],
      "@hooks/*":      ["src/hooks/*"],
      "@assets/*":     ["src/assets/*"],
      "@store/*":      ["src/store/*"],
      "@types/*":      ["src/types/*"]
    }
  }
}
